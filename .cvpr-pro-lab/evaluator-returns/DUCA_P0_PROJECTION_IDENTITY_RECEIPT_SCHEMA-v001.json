  "$defs": {
    "decimal_integer": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "fixture_tuple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_id", "T", "K", "Q", "u", "a"],
      "properties": {
        "fixture_id": {"type": "string", "minLength": 1},
        "T": {"type": "integer", "minimum": 16},
        "K": {"type": "integer", "minimum": 16, "maximum": 384},
        "Q": {"const": 1048576},
        "u": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0}
        },
        "a": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0}
        }
      }
    },
    "feasibility_certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "length",
        "first_position",
        "last_position",
        "strides",
        "minimum_stride",
        "maximum_stride",
        "maximum_uniform_displacement",
        "uniform_witness_feasible",
        "all_constraints_pass"
      ],
      "properties": {
        "length": {"type": "integer", "minimum": 16, "maximum": 384},
        "first_position": {"type": "integer", "minimum": 0},
        "last_position": {"type": "integer", "minimum": 0},
        "strides": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1, "maximum": 4}
        },
        "minimum_stride": {"type": "integer", "minimum": 1, "maximum": 4},
        "maximum_stride": {"type": "integer", "minimum": 1, "maximum": 4},
        "maximum_uniform_displacement": {"type": "integer", "minimum": 0, "maximum": 16},
        "uniform_witness_feasible": {"type": "boolean"},
        "all_constraints_pass": {"type": "boolean"}
      }
    },
    "objective_certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "E2_decimal",
        "E_infinity_decimal",
        "E1_decimal",
        "U1_decimal",
        "internal_position_vector",
        "exact_recomputation_pass"
      ],
      "properties": {
        "E2_decimal": {"$ref": "#/$defs/decimal_integer"},
        "E_infinity_decimal": {"$ref": "#/$defs/decimal_integer"},
        "E1_decimal": {"$ref": "#/$defs/decimal_integer"},
        "U1_decimal": {"$ref": "#/$defs/decimal_integer"},
        "internal_position_vector": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1}
        },
        "exact_recomputation_pass": {"type": "boolean"}
      }
    },
    "implementation_certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_id",
        "implementation",
        "status",
        "p",
        "feasibility",
        "objective",
        "typed_failure",
        "deviation"
      ],
      "properties": {
        "fixture_id": {"type": "string", "minLength": 1},
        "implementation": {"enum": ["production", "independent_reference"]},
        "status": {"enum": ["PASS", "BLOCKED"]},
        "p": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0}
        },
        "feasibility": {"$ref": "#/$defs/feasibility_certificate"},
        "objective": {"$ref": "#/$defs/objective_certificate"},
        "typed_failure": {"type": ["string", "null"]},
        "deviation": {"type": "string"}
      }
    },
    "identity_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_id",
        "p_identical",
        "E2_identical",
        "E_infinity_identical",
        "E1_identical",
        "U1_identical",
        "internal_position_vector_identical",
        "feasibility_certificate_identical",
        "overall_status",
        "first_mismatch"
      ],
      "properties": {
        "fixture_id": {"type": "string", "minLength": 1},
        "p_identical": {"type": "boolean"},
        "E2_identical": {"type": "boolean"},
        "E_infinity_identical": {"type": "boolean"},
        "E1_identical": {"type": "boolean"},
        "U1_identical": {"type": "boolean"},
        "internal_position_vector_identical": {"type": "boolean"},
        "feasibility_certificate_identical": {"type": "boolean"},
        "overall_status": {"enum": ["PASS", "P0_BLOCKED"]},
        "first_mismatch": {"type": ["string", "null"]}
      }
    },
    "exhaustive_certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_id",
        "T",
        "K",
        "feasible_sequence_count_decimal",
        "minimizer_count_decimal",
        "selected_long_stride_index",
        "winner_p",
        "winner_objective",
        "every_loser_first_difference",
        "status"
      ],
      "properties": {
        "fixture_id": {"enum": ["t385_exact_s37", "t385_full_key_tie"]},
        "T": {"const": 385},
        "K": {"const": 384},
        "feasible_sequence_count_decimal": {"const": "383"},
        "minimizer_count_decimal": {"const": "1"},
        "selected_long_stride_index": {"type": "integer", "minimum": 0, "maximum": 382},
        "winner_p": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0, "maximum": 384},
          "minItems": 384,
          "maxItems": 384
        },
        "winner_objective": {"$ref": "#/$defs/objective_certificate"},
        "every_loser_first_difference": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["long_stride_index", "first_key_field"],
            "properties": {
              "long_stride_index": {"type": "integer", "minimum": 0, "maximum": 382},
              "first_key_field": {
                "enum": ["E2", "E_infinity", "E1", "U1", "position_vector"]
              }
            }
          },
          "minItems": 382,
          "maxItems": 382
        },
        "status": {"enum": ["PASS", "P0_BLOCKED"]}
      }
    }
  }
}
